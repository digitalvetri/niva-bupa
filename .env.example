# Dev/app database (the running dashboard reads this).
DATABASE_URL="postgresql://USER@localhost:5432/territory_iq?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/territory_iq?schema=public"
# Separate DB for the test suite — tests TRUNCATE, so it must NOT be the dev DB.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/territory_iq_test?schema=public"
DEFAULT_TENANT_ID="00000000-0000-0000-0000-000000000001"
# Bot (Phase 3) — required for "Ask Territory IQ" router+narrator calls.
ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-6"   # override the bot model (spec default: claude-sonnet-4-6)
# Nudge (Phase 4) — n8n webhook → WhatsApp Cloud API. Unset: nudges queue + copy-to-clipboard fallback.
# N8N_NUDGE_WEBHOOK="https://your-n8n/webhook/nudge"
# Hardening (Phase 5) — optional
# SENTRY_DSN="https://...@sentry.io/..."   # wire the observability shim to Sentry
# OBSERVABILITY_LOG=1                        # log tracked metrics (ingestion issues, etc.)
# The bot provider/key can also be set per-tenant in Settings (Anthropic/Groq/Gemini/OpenAI).
# ANTHROPIC_API_KEY here is the environment fallback used when no tenant key is set.
